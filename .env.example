# Musanad Contracts — Frontend environment variables.
#
# Copy to .env.local for local development. .env.local is git-ignored.
# Vite only exposes variables prefixed with VITE_* to the client bundle.

# Backend API base URL. Backend listens on 4000 by default.
VITE_API_BASE_URL=http://localhost:4000

# Display timezone for formatDateTime output (per project.config.json).
VITE_DISPLAY_TIMEZONE=Asia/Dubai

# Default UI locale on first load. Detector overrides at runtime.
VITE_DEFAULT_LOCALE=en
